#!/usr/bin/env bash
set -euo pipefail

tap=zetaloop/zetaloop
tap_dir="$(brew --repository)/Library/Taps/zetaloop/homebrew-zetaloop"
mkdir -p "$(dirname "$tap_dir")"
ln -s "$GITHUB_WORKSPACE" "$tap_dir"
brew trust "$tap"
cd "$tap_dir"
git remote set-head origin main

brew livecheck --json --newer-only --full-name --casks --tap="$tap" |
  jq -r '.[] | select(.version.outdated) | [.cask, .version.latest] | @tsv' |
  while IFS=$'\t' read -r cask version; do
    brew bump-cask-pr --write-only --commit --version="$version" "$cask"
  done

git push
