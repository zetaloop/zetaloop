#!/usr/bin/env bash
set -euo pipefail

nix flake update

NIX_PATH="nixpkgs=$(nix eval --raw --impure --expr '(builtins.getFlake (toString ./.)).inputs.nixpkgs.outPath')"
export NIX_PATH

system=$(nix eval --raw --impure --expr builtins.currentSystem)
packages=$(nix eval --raw ".#packages.$system" --apply 'p: builtins.concatStringsSep "\n" (builtins.filter (name: builtins.hasAttr "updateScript" (builtins.getAttr name p)) (builtins.attrNames p))')

for package in $packages; do
  nix-update "$package" --flake --use-update-script
done

nixfmt flake.nix pkgs/*.nix pkgs/fonts/*.nix
