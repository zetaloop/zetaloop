{
    "version": "0.2.0",
    "description": "Proxy orchestration across Xray, sing-box, and Mihomo",
    "homepage": "https://github.com/zetaloop/overcast",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zetaloop/overcast/releases/download/v0.2.0/overcast-x86_64-pc-windows-msvc.exe#/overcast.exe",
            "hash": "c5f65a5e0b574c8106aafd28a1a39de02210f1360036e135ec6a63912894ac66"
        },
        "arm64": {
            "url": "https://github.com/zetaloop/overcast/releases/download/v0.2.0/overcast-aarch64-pc-windows-msvc.exe#/overcast.exe",
            "hash": "c965c0697a64861658e5c00e039362ed968fa0abd1f844100d6e3068397afce1"
        }
    },
    "bin": "overcast.exe",
    "post_install": [
        "$channel = @{ name = 'Scoop'; executable = \"$dir\\overcast.exe\" } | ConvertTo-Json",
        "[IO.File]::WriteAllText(\"$dir\\overcast.channel\", $channel)",
        "if ($env:SCOOP_OVERCAST_RESTART -eq $dir) {",
        "    Start-Service overcast -ErrorAction Stop",
        "    Remove-Item Env:SCOOP_OVERCAST_RESTART",
        "}"
    ],
    "pre_uninstall": [
        "$service = Get-CimInstance Win32_Service -Filter \"Name = 'overcast'\"",
        "$entry = (Get-Content -Raw -LiteralPath \"$dir\\overcast.channel\" | ConvertFrom-Json).executable",
        "if ($service -and $service.PathName -match ('^(?:\"{0}\"|{0})\\s+--run(?:\\s|$)' -f [regex]::Escape($entry))) {",
        "    if ($service.State -ne 'Stopped') {",
        "        Stop-Service overcast -ErrorAction Stop",
        "        if ($cmd -eq 'update' -and $service.State -in 'Running', 'Start Pending') { $env:SCOOP_OVERCAST_RESTART = Split-Path $entry }",
        "    }",
        "    if ($cmd -eq 'uninstall') {",
        "        sc.exe delete overcast",
        "        if ($LASTEXITCODE) { throw \"sc.exe delete overcast failed: $LASTEXITCODE\" }",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zetaloop/overcast/releases/download/v$version/overcast-x86_64-pc-windows-msvc.exe#/overcast.exe"
            },
            "arm64": {
                "url": "https://github.com/zetaloop/overcast/releases/download/v$version/overcast-aarch64-pc-windows-msvc.exe#/overcast.exe"
            }
        }
    }
}
