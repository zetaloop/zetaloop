{
    "version": "3.0",
    "description": "Alibaba PuHuiTi Chinese sans-serif font family",
    "homepage": "https://www.alibabafonts.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.alibabafonts.com/"
    },
    "url": "https://raw.githubusercontent.com/zetaloop/zetaloop/main/scripts/install-fonts.ps1",
    "pre_install": [
        "$url = 'https://fonts.alibabadesign.com/AlibabaPuHuiTi-3.zip'",
        "$archive = cache_path $app $version $url",
        "if (!(Test-Path $archive) -or !$use_cache) {",
        "    ensure $cachedir | Out-Null",
        "    Invoke-WebRequest $url -Headers @{ Referer = 'https://www.alibabafonts.com/' } -OutFile \"${archive}.download\"",
        "    Move-Item \"${archive}.download\" $archive -Force",
        "} else {",
        "    Write-Host 'Loading AlibabaPuHuiTi-3.zip from cache.'",
        "}",
        "$ok, $hashError = check_hash $archive 'f25f730b6a7661bcd5b9764dc98f05d3ac25ee771977cf04b31ed5fba9f496a7' $app",
        "if (!$ok) { Remove-Item $archive -Force; throw $hashError }",
        "Expand-7zipArchive $archive $dir",
        "if (!$use_cache) { Remove-Item $archive -Force }"
    ],
    "installer": {
        "script": [
            "Copy-Item (Join-Path (Find-BucketDirectory $bucket -Root) \"scripts\\install-fonts.ps1\") $dir -ErrorAction Stop",
            "& \"$dir\\install-fonts.ps1\" install"
        ]
    },
    "uninstaller": {
        "script": "& \"$dir\\install-fonts.ps1\" uninstall"
    }
}
