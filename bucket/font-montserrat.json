{
    "version": "9.000",
    "description": "Geometric sans-serif variable fonts with Montserrat Alternates",
    "homepage": "https://github.com/JulietaUla/Montserrat",
    "license": "OFL-1.1",
    "url": "https://github.com/JulietaUla/Montserrat/archive/refs/tags/v9.000.tar.gz",
    "hash": "991b3f971c65081c780fa15645a030bdf9e21ee8734b9f6010638b83bae1ff83",
    "extract_dir": "Montserrat-9.000",
    "pre_install": "Copy-Item (Join-Path (Find-BucketDirectory $bucket -Root) \"scripts\\install-fonts.ps1\") $dir -ErrorAction Stop",
    "installer": {
        "file": "install-fonts.ps1",
        "args": [
            "install",
            "$dir\\fonts\\variable",
            "$dir\\fonts-alternates\\variable"
        ]
    },
    "uninstaller": {
        "file": "install-fonts.ps1",
        "args": [
            "uninstall",
            "$dir\\fonts\\variable",
            "$dir\\fonts-alternates\\variable"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/JulietaUla/Montserrat/tags?per_page=1",
        "jsonpath": "$[0].name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/JulietaUla/Montserrat/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "Montserrat-$version"
    }
}
