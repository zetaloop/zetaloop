{
    "version": "1.071",
    "description": "LXGW Neo ZhiSong Chinese serif font with local metrics variant",
    "homepage": "https://github.com/lxgw/LxgwNeoZhiSong",
    "license": "IPA",
    "depends": "main/uv",
    "url": [
        "https://github.com/lxgw/LxgwNeoZhiSong/releases/download/v1.071/LXGWNeoZhiSong.ttf",
        "https://raw.githubusercontent.com/zetaloop/zetaloop/main/scripts/transform-neozhisong.py"
    ],
    "hash": [
        "fd5856f9e43513ab1ed6e50abd057b37b50f15faae1ff292c028049f168cb44f",
        "29b769dc1ae66357c306f67e24d3f5fbc9f485f621aa21e0843fa66c823a7461"
    ],
    "pre_install": [
        "uv run \"$dir\\transform-neozhisong.py\" \"$dir\\LXGWNeoZhiSong.ttf\"",
        "if ($LASTEXITCODE -ne 0) { throw 'NeoZhiSong font transformation failed' }"
    ],
    "installer": {
        "script": [
            "Copy-Item (Join-Path (Find-BucketDirectory $bucket -Root) \"scripts\\install-fonts.ps1\") $dir -ErrorAction Stop",
            "& \"$dir\\install-fonts.ps1\" install"
        ]
    },
    "uninstaller": {
        "script": "& \"$dir\\install-fonts.ps1\" uninstall"
    },
    "checkver": "github",
    "autoupdate": {
        "url": [
            "https://github.com/lxgw/LxgwNeoZhiSong/releases/download/v$version/LXGWNeoZhiSong.ttf",
            "https://raw.githubusercontent.com/zetaloop/zetaloop/main/scripts/transform-neozhisong.py"
        ]
    }
}
