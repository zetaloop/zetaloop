{
    "version": "0.2.0",
    "description": "Shows what Explorer just undid or redid.",
    "homepage": "https://github.com/zetaloop/UndoWhat",
    "license": "Unlicense",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zetaloop/UndoWhat/releases/download/v0.2.0/undowhat-x64.zip",
            "hash": "66464b634168815e271f33c8a9c5a1e3c7c3b125240d70732770d8ade1e41007"
        }
    },
    "post_install": [
        "if ($cmd -ne 'update') {",
        "    $clsid = '{DF7344C6-372C-4B87-A289-D3C9CD0BFD2B}'",
        "    $command = \"`$ErrorActionPreference = 'Stop'; New-Item -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\UndoWhat' -Value '$clsid' -Force | Out-Null\"",
        "    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "    sudo powershell -NoProfile -EncodedCommand $encoded",
        "    if ($LASTEXITCODE -ne 0) { throw \"注册 UndoWhat 失败，退出代码：$LASTEXITCODE\" }",
        "    $server = \"HKCU:\\Software\\Classes\\CLSID\\$clsid\\InprocServer32\"",
        "    New-Item -Path $server -Value \"$dir\\undowhat.dll\" -Force -ErrorAction Stop | Out-Null",
        "    New-ItemProperty -Path $server -Name ThreadingModel -Value Apartment -Force -ErrorAction Stop | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $uninstall = {",
        "        param([string] $directory)",
        "        $ErrorActionPreference = 'Stop'",
        "        $ProgressPreference = 'SilentlyContinue'",
        "        $dll = 'undowhat.dll'",
        "        [Microsoft.Win32.Registry]::LocalMachine.DeleteSubKey('SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers\\UndoWhat', $false)",
        "        Add-Type -Namespace Win32 -Name Files -MemberDefinition '[DllImport(\"kernel32.dll\", CharSet = CharSet.Unicode, SetLastError = true)] public static extern bool MoveFileEx(string source, string destination, uint flags);'",
        "        foreach ($version in [IO.Directory]::EnumerateDirectories((Split-Path $directory -Parent))) {",
        "            $file = Join-Path $version $dll",
        "            if (![IO.File]::Exists($file)) { continue }",
        "            $temporary = [IO.Path]::GetTempFileName()",
        "            if (![Win32.Files]::MoveFileEx($file, $temporary, 1)) {",
        "                throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())",
        "            }",
        "            if (![Win32.Files]::MoveFileEx($temporary, [NullString]::Value, 4)) {",
        "                throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())",
        "            }",
        "        }",
        "    }",
        "    $directory = $dir.Replace(\"'\", \"''\")",
        "    $command = \"& { $uninstall } '$directory'\"",
        "    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "    sudo powershell -NoProfile -EncodedCommand $encoded",
        "    if ($LASTEXITCODE -ne 0) { throw \"移除 UndoWhat 失败，退出代码：$LASTEXITCODE\" }",
        "    [Microsoft.Win32.Registry]::CurrentUser.DeleteSubKeyTree('Software\\Classes\\CLSID\\{DF7344C6-372C-4B87-A289-D3C9CD0BFD2B}', $false)",
        "}"
    ],
    "notes": "重新启动 Explorer 后生效。",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zetaloop/UndoWhat/releases/download/v$version/undowhat-x64.zip"
            }
        }
    }
}
