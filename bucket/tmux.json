{
    "version": "3.8-1",
    "description": "Terminal multiplexer for Git for Windows",
    "homepage": "https://github.com/tmux/tmux",
    "license": "ISC",
    "depends": [
        "main/git",
        "zetaloop/libevent"
    ],
    "architecture": {
        "64bit": {
            "url": "https://mirror.msys2.org/msys/x86_64/tmux-3.8-1-x86_64.pkg.tar.zst",
            "hash": "8ccd83d29f0f29aa5ed283f00c4770e55731a0f36e488ed05d7a5226034c2560"
        }
    },
    "pre_install": [
        "if ([Runtime.InteropServices.RuntimeInformation]::OSArchitecture -eq 'Arm64') { abort \"MSYS2 does not publish an ARM64 tmux package.\" }",
        "Copy-Item (Join-Path (Find-BucketDirectory $bucket -Root) \"scripts\\tmux\\tmux\") $dir -ErrorAction Stop",
        "Copy-Item \"$(versiondir 'scoop' 'current')\\supporting\\shims\\71\\shim.exe\" \"$dir\\tmux.exe\"",
        "$tmuxRoot = & \"$env:GIT_INSTALL_ROOT\\usr\\bin\\cygpath.exe\" -u \"$dir\"",
        "$libeventBin = & \"$env:GIT_INSTALL_ROOT\\usr\\bin\\cygpath.exe\" -u (Get-AppFilePath 'libevent' 'usr\\bin')",
        "@(\"path = `\"$env:GIT_INSTALL_ROOT\\usr\\bin\\bash.exe`\"\", \"args = --noprofile --norc `\"$tmuxRoot/tmux`\" `\"$libeventBin`\"\") -join \"`r`n\" | Out-UTF8File \"$dir\\tmux.shim\""
    ],
    "bin": "tmux.exe",
    "checkver": {
        "url": "https://packages.msys2.org/packages/tmux?variant=x86_64",
        "regex": "msys/x86_64/tmux-([\\d.a-z]+-\\d+)-x86_64\\.pkg\\.tar\\.zst"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://mirror.msys2.org/msys/x86_64/tmux-$version-x86_64.pkg.tar.zst"
            }
        }
    }
}
