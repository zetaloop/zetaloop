{
    "version": "0.1.0",
    "description": "Forcing DECSET 2031 support into Windows Terminal.",
    "homepage": "https://github.com/zetaloop/wt2031support",
    "license": "Unlicense",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zetaloop/wt2031support/releases/download/v0.1.0/wt2031support-x64.zip",
            "hash": "4f73b356a97bb9b988fdc781bc3b12417dd8eec320913e77ba7f69cd8fc6b759"
        }
    },
    "post_install": [
        "if ($cmd -ne 'update') {",
        "    $install = {",
        "        param([string] $target)",
        "        $ErrorActionPreference = 'Stop'",
        "        $ProgressPreference = 'SilentlyContinue'",
        "        $dll = 'wt2031support.dll'",
        "        $link = Join-Path $env:WINDIR \"System32\\$dll\"",
        "        if (!(Test-Path -LiteralPath $link)) {",
        "            New-Item -ItemType SymbolicLink -Path $link -Target $target | Out-Null",
        "        }",
        "        $key = [Microsoft.Win32.Registry]::LocalMachine.CreateSubKey('SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\WindowsTerminal.exe')",
        "        try {",
        "            $providers = @($key.GetValue('VerifierDlls', '') -split '\\s+' | Where-Object { $_ -and $_ -ne $dll })",
        "            $key.SetValue('VerifierDlls', (($providers + $dll) -join ' '), [Microsoft.Win32.RegistryValueKind]::String)",
        "            $key.SetValue('GlobalFlag', ([int] $key.GetValue('GlobalFlag', 0) -bor 0x100), [Microsoft.Win32.RegistryValueKind]::DWord)",
        "        } finally {",
        "            $key.Dispose()",
        "        }",
        "    }",
        "    $target = \"$dir\\wt2031support.dll\".Replace(\"'\", \"''\")",
        "    $command = \"& { $install } '$target'\"",
        "    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "    sudo powershell -NoProfile -EncodedCommand $encoded",
        "    if ($LASTEXITCODE -ne 0) { throw \"注册终端扩展失败，退出代码：$LASTEXITCODE\" }",
        "}"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $uninstall = {",
        "        param([string] $directory)",
        "        $ErrorActionPreference = 'Stop'",
        "        $ProgressPreference = 'SilentlyContinue'",
        "        $dll = 'wt2031support.dll'",
        "        $path = 'SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\WindowsTerminal.exe'",
        "        $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($path, $true)",
        "        if ($key) {",
        "            try {",
        "                $providers = @($key.GetValue('VerifierDlls', '') -split '\\s+' | Where-Object { $_ -and $_ -ne $dll })",
        "                if ($providers.Count) {",
        "                    $key.SetValue('VerifierDlls', ($providers -join ' '), [Microsoft.Win32.RegistryValueKind]::String)",
        "                } else {",
        "                    $key.DeleteValue('VerifierDlls', $false)",
        "                    $flags = [int] $key.GetValue('GlobalFlag', 0) -band (-bnot 0x100)",
        "                    if ($flags) {",
        "                        $key.SetValue('GlobalFlag', $flags, [Microsoft.Win32.RegistryValueKind]::DWord)",
        "                    } else {",
        "                        $key.DeleteValue('GlobalFlag', $false)",
        "                    }",
        "                }",
        "                $empty = $key.ValueCount -eq 0 -and $key.SubKeyCount -eq 0",
        "            } finally {",
        "                $key.Dispose()",
        "            }",
        "            if ($empty) { [Microsoft.Win32.Registry]::LocalMachine.DeleteSubKey($path, $false) }",
        "        }",
        "        [IO.File]::Delete((Join-Path $env:WINDIR \"System32\\$dll\"))",
        "        Add-Type -Namespace Win32 -Name Files -MemberDefinition '[DllImport(\"kernel32.dll\", CharSet = CharSet.Unicode, SetLastError = true)] public static extern bool MoveFileEx(string source, string destination, uint flags);'",
        "        foreach ($version in [IO.Directory]::EnumerateDirectories((Split-Path $directory -Parent))) {",
        "            $file = Join-Path $version $dll",
        "            if (![IO.File]::Exists($file)) { continue }",
        "            $temporary = [IO.Path]::GetTempFileName()",
        "            if (![Win32.Files]::MoveFileEx($file, $temporary, 1)) {",
        "                throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())",
        "            }",
        "            if (![Win32.Files]::MoveFileEx($temporary, [NullString]::Value, 4)) {",
        "                throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())",
        "            }",
        "        }",
        "    }",
        "    $directory = $dir.Replace(\"'\", \"''\")",
        "    $command = \"& { $uninstall } '$directory'\"",
        "    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "    sudo powershell -NoProfile -EncodedCommand $encoded",
        "    if ($LASTEXITCODE -ne 0) { throw \"移除终端扩展失败，退出代码：$LASTEXITCODE\" }",
        "}"
    ],
    "notes": "重新启动 Windows Terminal 后生效。",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zetaloop/wt2031support/releases/download/v$version/wt2031support-x64.zip"
            }
        }
    }
}
