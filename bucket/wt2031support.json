{
    "version": "0.2.1",
    "description": "Forcing DECSET 2031 support into Windows Terminal.",
    "homepage": "https://github.com/zetaloop/wt2031support",
    "license": "Unlicense",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zetaloop/wt2031support/releases/download/v0.2.1/wt2031support-x64.zip",
            "hash": "d3dfb79209a4c8b0f6c742b76dc99191e35fa78de9f84084db72ba4eab0c6272"
        }
    },
    "bin": [
        [
            "wt2031activator.exe",
            "wt2031support"
        ]
    ],
    "pre_uninstall": [
        "$file = Join-Path $dir 'wt2031support.dll'",
        "if ([IO.File]::Exists($file)) {",
        "    Add-Type -Namespace Wt2031 -Name Files -MemberDefinition '[DllImport(\"kernel32.dll\", CharSet = CharSet.Unicode, SetLastError = true)] public static extern bool MoveFileEx(string source, string destination, uint flags);'",
        "    $temporary = Join-Path ([IO.Path]::GetTempPath()) \"wt2031support-$([guid]::NewGuid()).dll\"",
        "    if (![Wt2031.Files]::MoveFileEx($file, $temporary, 0)) {",
        "        throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zetaloop/wt2031support/releases/download/v$version/wt2031support-x64.zip"
            }
        }
    }
}
